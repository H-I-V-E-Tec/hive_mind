# Hive identity and immutable process role.
HIVE_ID=research-team
HIVE_DEVICE_ID=workstation-a
HIVE_ROLE=writer
# Referência sanitizada do change/ticket que autorizou este writer.
HIVE_WRITER_APPROVAL_ID=change-1042
HIVE_COLLECTION=hive_mind_v01
HIVE_DATA_DIR=/absolute/path/to/hive-data
HIVE_AUDIT_DIR=/absolute/path/outside-hive-data/audit

# Qdrant must use HTTPS outside loopback. Inject the real key through the
# process environment or a secret manager; never put it in this example.
QDRANT_URL=https://qdrant.hive.internal:6334
QDRANT_API_KEY=replace-via-secret-manager
QDRANT_TLS_CA_FILE=/absolute/path/to/hive-ca.pem
# QDRANT_TLS_SERVER_NAME=qdrant.hive.internal

# Ollama remains local in v0.1.
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text

# Safe default; set restricted only on an authorized device.
HIVE_MAX_CLASSIFICATION=internal
HIVE_CONTEXT_MAX_CHARS=12000

# Limites seguros da ingestão (opcionais; estes são os padrões).
HIVE_MAX_FILE_BYTES=5242880
HIVE_MAX_CHUNKS_PER_FILE=1000
HIVE_CHUNK_MAX_CHARS=2000
HIVE_CHUNK_OVERLAP_CHARS=200
HIVE_JSON_MAX_DEPTH=64
HIVE_JSON_MAX_ELEMENTS=100000
HIVE_MAX_EMBEDDING_WORKERS=2
HIVE_DELETE_GRACE_HOURS=24
