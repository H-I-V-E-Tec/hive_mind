# /srv/hive-private/hive.env — root:root 0600
# Copy this file to /srv/hive-private/hive.env and fill in values.

# --- Identity ---
HIVE_ID=production
HIVE_DEVICE_ID=server-01

# --- Role ---
# writer: watches HIVE_DATA_DIR, accepts ingest
# reader: read-only queries
HIVE_ROLE=writer

# --- Qdrant (local Docker) ---
HIVE_COLLECTION=hive_collection
QDRANT_URL=https://127.0.0.1:6334
QDRANT_API_KEY=changeme
# Public CA copy: the hive user cannot traverse /srv/hive-private (0700 root).
QDRANT_TLS_CA_FILE=/srv/hive-public/ca.crt

# --- Ollama (local) ---
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text

# --- Data directory (writer only) ---
HIVE_DATA_DIR=/srv/hive-data
HIVE_WRITER_APPROVAL_ID=initial-deploy

# --- HTTP server ---
HIVE_CENTER_URL=https://hive-center.com.br
# Gateway of the HIVE Center compose network (COMPOSE_SUBNET 172.28.0.0/24):
# only the Center's Caddy reaches it and publishes it at <center>/mind.
HIVE_HTTP_ADDR=172.28.0.1:8443
# HIVE_HTTP_TLS_CERT=/srv/hive-private/tls/server.crt
# HIVE_HTTP_TLS_KEY=/srv/hive-private/tls/server.key

# --- Audit ---
HIVE_AUDIT_DIR=/var/lib/hive/audit
