[Unit]
Description=Hive Mind HTTP API Server
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/opt/hive-mind/current/hive serve
EnvironmentFile=/srv/hive-private/hive.env
UnsetEnvironment=OLLAMA_HOST QDRANT_HOST QDRANT_PORT QDRANT_COLLECTION HIVE_MODE WATCH_DIRECTORY
Restart=on-failure
RestartSec=5
User=hive
Group=hive
WorkingDirectory=/var/lib/hive
StateDirectory=hive
LogsDirectory=hive

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hive /srv/hive-data
ReadOnlyPaths=/srv/hive-private /opt/hive-mind

[Install]
WantedBy=multi-user.target
